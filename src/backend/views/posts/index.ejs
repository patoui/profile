<%- include('../partials/header', { title: 'Articles', currentPath: '/blog' }) %>

<h1 class="text-4xl mb-4">Articles</h1>
<% posts.forEach(function(post) { %>
<div class="mb-6 w-full">
    <a href="/post/<%= post.slug %>" class="no-underline font-semibold text-black text-xl hover:underline block"><%= post.title %></a>
    <p class="mt-2 mb-2 text-sm text-gray-700"><%= post.shortBody %></p>
    <p class="text-sm text-gray-600">Published on <%= post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '' %></p>
    <div>
        <% post.tagNames.forEach(function(tag) { %>
        <a href="/blog?tag=<%= encodeURIComponent(tag) %>" class="inline-block bg-gray-100 rounded-full px-3 py-1 text-xs text-gray-600 mr-2 hover:text-black hover:underline">#<%= tag %></a>
        <% }); %>
    </div>
</div>
<% }); %>

<%- include('../partials/footer') %>
