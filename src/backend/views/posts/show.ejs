<%- include('../partials/header-pre-meta', { title: post.title, currentPath: '/blog' }) %>

<%- include('../partials/article-meta', {
    title: post.title,
    description: post.shortBody,
    type: 'article',
    publishedAt: post.publishedAt,
    tagNames: post.tagNames,
    urlPath: 'post',
    slug: post.slug
}) %>

<%- include('../partials/header-post-meta', { title: post.title, currentPath: '/blog', css: '<link rel="stylesheet" href="/dist/highlight.css">' }) %>

<%- include('../partials/article-header', { title: post.title, publishedAt: post.publishedAt }) %>

<div class="w-full pt-4 pb-4 markdown-body"><%- post.bodyHtml %></div>

<%- include('../partials/article-navigation', { previous: previousPost, next: nextPost, urlPath: 'post', truncate: true }) %>

<%- include('../partials/highlight') %>

<%- include('../partials/footer') %>
