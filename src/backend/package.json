{
  "name": "@nodejs-profile/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend for nodejs-profile",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "routes": "tsx ../../scripts/list-routes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "contract:emit": "prisma contract emit --config=../../prisma.config.ts",
    "db:init": "prisma db init --config=../../prisma.config.ts --db \"$DATABASE_URL\"",
    "db:sign": "prisma db sign --config=../../prisma.config.ts --db \"$DATABASE_URL\"",
    "db:verify": "prisma db verify --config=../../prisma.config.ts --db \"$DATABASE_URL\"",
    "db:migrate": "prisma db migrate --config=../../prisma.config.ts --db \"$DATABASE_URL\"",
    "db:seed": "node --import tsx ./scripts/seed.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:unit": "vitest run tests/unit",
    "test:run:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run tests/unit --coverage",
    "test:coverage:integration": "vitest run --config vitest.integration.config.ts --coverage"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "feed": "^4.2.2",
    "marked": "^15.0.3",
    "pg": "^8.16.3",
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9.39.1",
    "express-list-routes": "^1.3.1",
    "prisma": "8.0.0-rc.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "5.0.0"
  }
}
