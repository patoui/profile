{
  "name": "@nodejs-profile/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend for nodejs-profile",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "routes": "tsx ../../scripts/list-routes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "db:push": "prisma db push --schema=../../prisma/schema.prisma",
    "db:seed": "tsx ../../prisma/seed.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:unit": "vitest run ../../tests/unit",
    "test:run:integration": "vitest run ../../tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run ../../tests/unit --coverage",
    "test:coverage:integration": "vitest run ../../tests/integration --coverage"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@prisma/instrumentation": "^7.0.0",
    "dd-trace": "^5.80.0",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/adapter-libsql": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.4.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "feed": "^4.2.2",
    "marked": "^15.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^4.0.13",
    "eslint": "^9.39.1",
    "express-list-routes": "^1.3.1",
    "prisma": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.13"
  }
}
