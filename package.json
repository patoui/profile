{
  "name": "nodejs-profile",
  "version": "1.0.0",
  "description": "Personal portfolio and blog website - monorepo",
  "private": true,
  "author": "Patrique Ouimet",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @nodejs-profile/backend dev",
    "dev:frontend": "pnpm --filter @nodejs-profile/frontend watch",
    "build": "pnpm --filter @nodejs-profile/frontend build && pnpm --filter @nodejs-profile/backend build",
    "start": "pnpm --filter @nodejs-profile/backend start",
    "lint": "pnpm --filter @nodejs-profile/backend lint",
    "lint:fix": "pnpm --filter @nodejs-profile/backend lint:fix",
    "db:generate": "pnpm --filter @nodejs-profile/backend db:generate",
    "db:migrate": "pnpm --filter @nodejs-profile/backend db:migrate",
    "db:deploy": "pnpm --filter @nodejs-profile/backend db:deploy",
    "db:push": "pnpm --filter @nodejs-profile/backend db:push",
    "db:seed": "pnpm --filter @nodejs-profile/backend db:seed",
    "test": "pnpm --filter @nodejs-profile/backend test",
    "test:run": "pnpm --filter @nodejs-profile/backend test:run",
    "test:run:unit": "pnpm --filter @nodejs-profile/backend test:run:unit",
    "test:run:integration": "pnpm --filter @nodejs-profile/backend test:run:integration",
    "test:coverage": "pnpm --filter @nodejs-profile/backend test:coverage",
    "test:coverage:unit": "pnpm --filter @nodejs-profile/backend test:coverage:unit",
    "test:coverage:integration": "pnpm --filter @nodejs-profile/backend test:coverage:integration"
  }
}
