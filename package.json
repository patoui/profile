{
  "name": "nodejs-profile",
  "version": "1.0.0",
  "type": "module",
  "description": "Personal portfolio and blog website",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:assets && tsc",
    "build:assets": "node build-assets.js",
    "watch:assets": "node build-assets.js --watch",
    "start": "node dist/index.js",
    "routes": "tsx scripts/list-routes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:unit": "vitest run tests/unit",
    "test:run:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run tests/unit --coverage",
    "test:coverage:integration": "vitest run tests/integration --coverage"
  },
  "keywords": [],
  "author": "Patrique Ouimet",
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/adapter-libsql": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.4.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "feed": "^4.2.2",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^4.0.13",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "express-list-routes": "^1.3.1",
    "postcss": "^8.5.6",
    "prisma": "^7.0.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.13"
  }
}
