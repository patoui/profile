<%- include('../partials/header-pre-meta', { title: tip.title, currentPath: '/tip' }) %>

<%- include('../partials/article-meta', {
    title: tip.title,
    description: tip.shortBody,
    type: 'article',
    publishedAt: tip.publishedAt,
    tagNames: tip.tagNames,
    urlPath: 'tip',
    slug: tip.slug
}) %>

<%- include('../partials/header-post-meta', { title: tip.title, currentPath: '/tip', css: '<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">' }) %>

<%- include('../partials/article-header', { title: tip.title, publishedAt: tip.publishedAt }) %>

<div class="w-full pt-4 pb-4 markdown-body"><%- tip.bodyHtml %></div>

<%- include('../partials/article-navigation', { previous: previousTip, next: nextTip, urlPath: 'tip', truncate: true }) %>

<%- include('../partials/highlight') %>

<%- include('../partials/footer') %>
