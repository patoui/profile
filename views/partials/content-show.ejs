<%- include('./header', { title: item.title, currentPath: currentPath, css: '<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">' }) %>

<h1 class="w-full text-4xl text-center font-bold"><%= item.title %></h1>
<p class="w-full text-sm text-center text-gray-600"><%= item.publishedAt ? new Date(item.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '' %></p>

<div class="w-full pt-4 pb-4 markdown-body"><%- item.bodyHtml %></div>

<% if (previousItem || nextItem) { %>
<div class="flex w-full mt-4 mb-4">
    <div class="w-1/2">
        <% if (previousItem) { %>
            <a class="underline" href="<%= basePath %>/<%= previousItem.slug %>">&#8678; <%= previousItem.title.length > 30 ? previousItem.title.substring(0, 30) + '...' : previousItem.title %></a>
        <% } %>
    </div>
    <div class="w-1/2 text-right">
        <% if (nextItem) { %>
            <a class="underline" href="<%= basePath %>/<%= nextItem.slug %>"><%= nextItem.title.length > 30 ? nextItem.title.substring(0, 30) + '...' : nextItem.title %> &#8680;</a>
        <% } %>
    </div>
</div>
<% } %>

<%- include('./highlight') %>

<%- include('./footer') %>
