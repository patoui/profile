<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="Patrique Ouimet">
    <%- typeof meta !== 'undefined' ? meta : '' %>

    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico"/>

    <title><%= typeof title !== 'undefined' && title ? title : '' %> | <%= typeof appName !== 'undefined' && appName ? appName : 'Profile' %></title>

    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .markdown-body { line-height: 1.6; }
        .markdown-body h1 { font-size: 2rem; font-weight: 700; margin: 1.5rem 0 1rem; }
        .markdown-body h2 { font-size: 1.5rem; font-weight: 600; margin: 1.25rem 0 0.75rem; }
        .markdown-body h3 { font-size: 1.25rem; font-weight: 600; margin: 1rem 0 0.5rem; }
        .markdown-body p { margin-bottom: 1rem; }
        .markdown-body pre { background: #f6f8fa; padding: 0.3rem; border-radius: 0.375rem; overflow-x: auto; margin-bottom: 1rem; }
        .markdown-body code { font-family: monospace; font-size: 0.875rem; }
        .markdown-body code:not([class]) { padding: .2em .4em; margin: 0; background-color: rgba(27, 31, 35, .05); border-radius: 3px; }
        .markdown-body ul { margin-bottom: 1rem; padding-left: 1.5rem; list-style-type: disc; }
        .markdown-body ol { margin-bottom: 1rem; padding-left: 1.5rem; list-style-type: decimal; }
        .markdown-body li { margin-bottom: 0.25rem; }
        .markdown-body a { color: #2563eb; }
        .markdown-body a:hover { text-decoration: underline; }
        .markdown-body blockquote { border-left: 4px solid #e5e7eb; padding-left: 1rem; font-style: italic; color: #6b7280; margin: 1rem 0; }
    </style>
    <%- typeof css !== 'undefined' ? css : '' %>
</head>
<body>
    <!-- Header -->
    <div class="flex mt-3 mb-3 mr-5 ml-5 items-center">
        <div class="flex w-5/6">
            <div class="mt-1 mr-2">
                <img src="/img/black-white-profile.png" alt="Grayscale profile picture" class="rounded-full w-12 m-auto mb-3" />
            </div>
            <div>
                <p class="block text-2xl">Patrique Ouimet</p>
                <p class="block text-xs italic">Senior Backend Software Engineer</p>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <div class="mb-4">
        <div class="flex justify-center w-full sm:w-4/5 md:w-4/5 lg:w-4/5 xl:w-3/5 pl-6 sm:pl-8 md:pl-12 lg:pl-20 xl:pl-24 pr-6 sm:pr-8 md:pr-12 lg:pr-20 xl:pr-24 mx-auto">
            <ul class="w-full p-3 list-reset flex border-solid border-b border-t border-gray-300">
                <li class="w-1/4 text-center">
                    <a class="<%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'text-black' : 'text-blue-600' %> font-semibold no-underline hover:text-black" href="/">About</a>
                </li>
                <li class="w-1/4 text-center">
                    <a class="<%= typeof currentPath !== 'undefined' && currentPath === '/blog' ? 'text-black' : 'text-blue-600' %> font-semibold no-underline hover:text-black" href="/blog">Blog</a>
                </li>
                <li class="w-1/4 text-center">
                    <a class="<%= typeof currentPath !== 'undefined' && currentPath === '/tip' ? 'text-black' : 'text-blue-600' %> font-semibold no-underline hover:text-black" href="/tip">Tips</a>
                </li>
                <li class="w-1/4 text-center">
                    <a class="<%= typeof currentPath !== 'undefined' && currentPath === '/video' ? 'text-black' : 'text-blue-600' %> font-semibold no-underline hover:text-black" href="/video">Videos</a>
                </li>
            </ul>
        </div>
    </div>

    <div class="flex justify-center">
        <div class="w-full sm:w-4/5 md:w-4/5 lg:w-4/5 xl:w-3/5 pl-6 sm:pl-8 md:pl-12 lg:pl-20 xl:pl-24 pr-6 sm:pr-8 md:pr-12 lg:pr-20 xl:pr-24 flex flex-wrap">
