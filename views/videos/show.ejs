<%- include('../partials/header-pre-meta', { title: video.title, currentPath: '/video' }) %>

<%- include('../partials/article-meta', {
    title: video.title,
    description: video.shortDescription,
    type: 'video.other',
    publishedAt: video.publishedAt,
    tagNames: video.tagNames,
    urlPath: 'video',
    slug: video.slug,
    videoUrl: video.embedUrl
}) %>

<%- include('../partials/header-post-meta', { title: video.title, currentPath: '/video' }) %>

<%- include('../partials/article-header', { title: video.title, publishedAt: video.publishedAt }) %>

<div class="block relative" style="max-width:600px; max-height:338px; width:90vw; height:50.85vw; margin: 1rem auto;">
    <iframe style="position:absolute; top:0; left:0; width:100%; height:100%; border: none;" src="<%= video.embedUrl %>" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
</div>

<%- include('../partials/article-navigation', { previous: previousVideo, next: nextVideo, urlPath: 'video', truncate: false }) %>

<%- include('../partials/footer') %>
