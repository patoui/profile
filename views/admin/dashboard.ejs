<%- include('../partials/admin-header', { title: 'Dashboard', currentPath: '' }) %>

<div class="w-full px-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Dashboard</h1>

    <!-- Stats Grid -->
    <div class="grid md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-sm font-medium text-gray-500 mb-2">Posts</h3>
            <p class="text-3xl font-bold text-gray-900"><%= stats.posts.published %> / <%= stats.posts.total %></p>
            <p class="text-sm text-gray-500">published</p>
            <a href="/admin/posts" class="text-blue-600 text-sm hover:underline mt-2 block">Manage</a>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-sm font-medium text-gray-500 mb-2">Tips</h3>
            <p class="text-3xl font-bold text-gray-900"><%= stats.tips.published %> / <%= stats.tips.total %></p>
            <p class="text-sm text-gray-500">published</p>
            <a href="/admin/tips" class="text-blue-600 text-sm hover:underline mt-2 block">Manage</a>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-sm font-medium text-gray-500 mb-2">Videos</h3>
            <p class="text-3xl font-bold text-gray-900"><%= stats.videos.published %> / <%= stats.videos.total %></p>
            <p class="text-sm text-gray-500">published</p>
            <a href="/admin/videos" class="text-blue-600 text-sm hover:underline mt-2 block">Manage</a>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-sm font-medium text-gray-500 mb-2">Total Views</h3>
            <p class="text-3xl font-bold text-gray-900"><%= analytics.total %></p>
            <p class="text-sm text-gray-500">all content</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Quick Actions</h2>
        <div class="flex gap-4">
            <a href="/admin/post/create" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">New Post</a>
            <a href="/admin/tip/create" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">New Tip</a>
            <a href="/admin/video/create" class="px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">New Video</a>
        </div>
    </div>

    <!-- Tags Overview -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Tags</h2>
        <% if (tags.length === 0) { %>
            <p class="text-gray-600">No tags yet.</p>
        <% } else { %>
            <div class="grid md:grid-cols-3 gap-4">
                <% tags.forEach(function(tag) { %>
                <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
                    <span class="font-medium"><%= tag.name %></span>
                    <span class="text-sm text-gray-500"><%= tag.postCount + tag.tipCount + tag.videoCount %> items</span>
                </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/admin-footer') %>
